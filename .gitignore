# Generated agent files: sync_agents.py --git track|ignore manages this for you.
# (Manual alternative below; do not combine with --git ignore.)

# Ignore whole folders manually (hides hand-written agents too). Uncomment:
# .claude/agents/
# .github/agents/
# .opencode/agents/
# .agents/skills/

# Machine-local harness state (not the canonical content; keep .lock.json if you
# want to pin what was generated).
.agents/.sync.json
.agents/.backups/
.agents/.lock.json

# Harness bundles (build artifacts)
*.dotagents

# Python
__pycache__/
*.pyc
