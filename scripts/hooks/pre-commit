#!/usr/bin/env bash
# Install with: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Use only if you COMMIT the generated files (Option B in .gitignore).
python harness.py sync --all || exit 1
for d in .claude/agents .github/agents .opencode/agents .agents/skills \
         .claude/scripts .github/scripts .opencode/scripts; do
  [ -e "$d" ] && git add -- "$d"
done
